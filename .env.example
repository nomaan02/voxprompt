# VoxPrompt settings
# 1. Copy this file and name the copy ".env" (same folder).
# 2. Replace the placeholder below with your own key.
# 3. Never commit your real .env file. It is already listed in .gitignore.

# Required: your Anthropic API key (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model rewrites your prompt
# VOXPROMPT_CLAUDE_MODEL=claude-sonnet-5-5

# Optional: Whisper speech model. "small.en" is faster on CPU-only machines.
# VOXPROMPT_WHISPER_MODEL=medium.en
